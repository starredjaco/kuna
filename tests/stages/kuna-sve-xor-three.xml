<stringmatch name="SVE XOR: repeats the destination and names both other sources in encoded order" min="1" max="1">eor3\s+z0\.D, z0\.D, z1\.D, z2\.D</stringmatch>
<stringmatch name="SVE XOR: stores the XOR of all three loaded vectors" min="1" max="1">SVE_st1b\([^,]+ \^ [^,]+ \^ SVE_ld1b\([^,]+,[^,]+,a2,0\),[^,]+,a0,0\);</stringmatch>
<stringmatch name="SVE XOR: reaches the return after the store" min="1" max="1">return 7;</stringmatch>
<stringmatch name="SVE XOR: only the unallocated word truncates its function" min="1" max="1">halt_baddata\(\);</stringmatch>
<stringmatch name="SVE XOR: equal sources cancel and the old destination reaches memory" min="1" max="1">SVE_st1b\(SVE_ld1b\([^,]+,[^,]+,a1,0\),[^,]+,a0,0\);</stringmatch>
